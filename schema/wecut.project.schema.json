{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/13kailouis-stack/wecut/main/schema/wecut.project.schema.json",
  "title": "WeCut project (format 1)",
  "description": "One video edit. Times are seconds. Clip from/to are seconds of the SOURCE file; every other time (texts, overlays, audio, filters, effects) is seconds of the FINISHED video. Positions x/y are fractions of the canvas, 0.5 = centre. Font sizes are pixels at 1080p and scale with the output. All file paths are relative to the workspace (--root).",
  "type": "object",
  "required": ["wecut", "clips"],
  "additionalProperties": false,
  "properties": {
    "wecut": { "const": "1", "description": "Format version. Always \"1\"." },
    "output": { "$ref": "#/$defs/output" },
    "clips": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "description": "The main track, played one after another.",
      "items": { "$ref": "#/$defs/clip" }
    },
    "texts": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/text" } },
    "captions": { "$ref": "#/$defs/captions" },
    "overlays": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/overlay" } },
    "audio": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/track" } },
    "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "gradients": { "type": "array", "maxItems": 8, "description": "Colour fades over the footage and under the text, like the dark fade behind captions.", "items": { "$ref": "#/$defs/gradient" } }
  },
  "$defs": {
    "inset": {
      "type": "object", "required": ["x", "y", "w", "h"], "additionalProperties": false,
      "description": "Shows the footage in a card on a plain background, in fractions of the canvas.",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 },
        "background": { "type": "string", "description": "#RRGGBB, default #0E0E0E." },
        "grid": { "type": "boolean", "description": "Thin grid lines on the background." },
        "radius": { "type": "number", "minimum": 0, "maximum": 300, "description": "Rounded corners, pixels at 1080." }
      }
    },
    "accent": {
      "type": "object", "additionalProperties": false,
      "description": "Sets key words apart. Without words, the longest word of each phrase.",
      "properties": {
        "words": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string", "description": "#RRGGBB." },
        "scale": { "type": "number", "minimum": 50, "maximum": 300, "description": "Percent of the caption size." },
        "italic": { "type": "boolean" },
        "font": { "type": "string", "description": "A bundled font (wecut list fonts)." }
      }
    },
    "gradient": {
      "type": "object", "required": ["from", "to"], "additionalProperties": false,
      "properties": {
        "from": { "type": "number", "minimum": 0, "maximum": 1, "description": "Height where the picture is still clear." },
        "to": { "type": "number", "minimum": 0, "maximum": 1, "description": "Height where the colour is full; it stays full from there to the edge of the frame. Below from darkens the bottom, above from darkens the top." },
        "color": { "type": "string", "description": "#RRGGBB, default #000000." },
        "opacity": { "type": "number", "minimum": 0, "maximum": 100, "description": "At to, default 100." },
        "start": { "$ref": "#/$defs/seconds" },
        "end": { "$ref": "#/$defs/seconds" }
      }
    },
    "seconds": { "type": "number", "minimum": 0 },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "#RRGGBB" },
    "colorOrNone": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|none)$", "description": "#RRGGBB, or \"none\" to turn it off" },
    "path": { "type": "string", "minLength": 1, "description": "File path relative to the workspace. URLs are not accepted." },

    "output": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "\\.(mp4|gif|MP4|GIF)$", "default": "out/wecut.mp4", "description": "Where to write the result, inside the workspace. .mp4 (H.264 + AAC) or .gif (silent, max 480p 15 fps)." },
        "ratio": { "enum": ["9:16", "16:9", "1:1", "4:5", "4:3", "3:4", "2:1", "original"], "default": "9:16", "description": "original = the first clip's shape." },
        "res": { "type": "integer", "minimum": 240, "maximum": 2160, "default": 1080, "description": "Short side in pixels. 1080 with 9:16 gives 1080x1920." },
        "fps": { "type": "integer", "minimum": 1, "maximum": 60, "default": 30 },
        "fit": { "enum": ["cover", "contain"], "default": "cover", "description": "cover fills the frame and crops; contain shows the whole clip on a background." },
        "background": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|blur)$", "default": "#000000", "description": "Behind contain clips: a colour, or \"blur\" for a blurred copy of the clip." },
        "blur": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
        "quality": { "enum": ["draft", "final", "high"], "default": "final", "description": "draft renders 540p fast for checking. The --preset flag overrides this." }
      }
    },

    "clip": {
      "type": "object", "required": ["src"], "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/$defs/path", "description": "Video (mp4, mov, m4v, mkv, webm) or image (png, jpg, webp)." },
        "from": { "$ref": "#/$defs/seconds", "description": "Video: start, in seconds of the source file." },
        "to": { "type": "number", "description": "Video: end, in seconds of the source file. Default: end of file." },
        "duration": { "type": "number", "minimum": 0.1, "default": 3, "description": "Image: seconds on screen." },
        "speed": { "type": "number", "minimum": 0.25, "maximum": 4, "default": 1, "description": "2 = twice as fast (half as long)." },
        "volume": { "type": "number", "minimum": 0, "maximum": 200, "default": 100, "description": "Percent of the clip's own sound." },
        "mute": { "type": "boolean" },
        "fit": { "enum": ["cover", "contain"], "description": "Overrides output.fit for this clip." },
        "focus": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "description": "Cover only: which part of the frame to keep when cropping. {x: 0.5, y: 0.5} is the centre; x 0.2 keeps the left side.",
          "properties": { "x": { "$ref": "#/$defs/fraction" }, "y": { "$ref": "#/$defs/fraction" } }
        },
        "zoom": { "type": "number", "minimum": 1, "maximum": 5, "default": 1, "description": "Cover only: punch in. Combine with focus." },
        "inset": { "$ref": "#/$defs/inset" },
        "zoomTo": { "type": "number", "minimum": 1, "maximum": 5, "description": "Cover only, video or photo: the zoom glides from zoom (default 1) to this over the clip, a slow push in (or out when smaller). Not with motion." },
        "rotate": { "enum": [0, 90, 180, 270, -90], "description": "Clockwise degrees." },
        "flip": { "type": "boolean", "description": "Mirror left-right." },
        "fadeIn": { "type": "number", "minimum": 0, "maximum": 10, "description": "Fade from black, seconds." },
        "fadeOut": { "type": "number", "minimum": 0, "maximum": 10, "description": "Fade to black, seconds." },
        "motion": { "enum": ["in", "out", "left", "right", "up", "down"], "description": "Image only: slow zoom or pan (Ken Burns)." },
        "transition": {
          "type": "object", "required": ["type"], "additionalProperties": false,
          "description": "Blend into the NEXT clip. The clips overlap, so the video gets shorter by duration.",
          "properties": {
            "type": { "type": "string", "description": "fade, dissolve, fadeblack, fadewhite (alias flash), slideleft, slideright, slideup, slidedown, wipeleft, wiperight, wipeup, wipedown, smoothleft, smoothright, smoothup, smoothdown, circleopen, circleclose, circlecrop, rectcrop, radial, pixelize, hblur, zoomin, squeezeh, squeezev, distance, fadegrays, diagtl, diagtr, diagbl, diagbr, vertopen, vertclose, horzopen, horzclose." },
            "duration": { "type": "number", "minimum": 0.1, "maximum": 3, "default": 0.5 }
          }
        }
      }
    },

    "look": {
      "type": "object",
      "description": "Appearance shared by texts and captions. Anything left out comes from the style.",
      "properties": {
        "style": { "type": "string", "description": "A preset. Run `wecut list styles` or `wecut list caption-styles`." },
        "font": { "enum": ["roboto", "montserrat", "poppins-medium", "poppins-semibold", "poppins", "poppins-extrabold", "poppins-black", "kanit", "kanit-black", "oswald", "barlow-condensed", "barlow-condensed-extrabold", "bebas", "anton", "archivo-black", "russo", "rubik-mono", "righteous", "bungee", "passion", "lilita", "titan", "luckiest", "bangers", "black-ops", "creepster", "nosifer", "alfa-slab", "abril", "dm-serif", "playfair", "shrikhand", "pacifico", "lobster", "dancing-script", "great-vibes", "satisfy", "permanent-marker", "caveat", "comic-neue"], "description": "Bundled fonts (`wecut list fonts`) cover Latin script; other scripts fall back to fonts installed on the machine. Fonts with a real italic face use it when italic is on." },
        "size": { "type": "number", "minimum": 8, "maximum": 400, "description": "Pixels at 1080p." },
        "color": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/colorOrNone", "description": "Outline colour." },
        "background": { "$ref": "#/$defs/colorOrNone", "description": "Box behind the text." },
        "backgroundOpacity": { "$ref": "#/$defs/percent" },
        "shadow": { "type": "boolean" },
        "opacity": { "$ref": "#/$defs/percent" },
        "letterSpacing": { "type": "number", "minimum": -10, "maximum": 50 },
        "uppercase": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right"], "description": "With left, x is the left edge; with right, x is the right edge." },
        "box": { "enum": ["line", "card"], "default": "line", "description": "How background is drawn: a box behind each line, or one card behind the whole block (news headline cards)." }
      }
    },

    "text": {
      "type": "object", "required": ["text"], "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/look" }],
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "Use \\n for a line break. Long lines wrap. Emoji are not drawn; use an image overlay." },
        "start": { "$ref": "#/$defs/seconds" },
        "end": { "type": "number", "description": "Default: end of the video." },
        "x": { "$ref": "#/$defs/fraction", "default": 0.5 },
        "y": { "$ref": "#/$defs/fraction", "default": 0.5 },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360, "description": "Clockwise degrees." },
        "maxWidth": { "type": "number", "minimum": 0.1, "maximum": 1, "default": 0.88, "description": "Widest a line may get, as a fraction of the canvas width, before it wraps." },
        "lineHeight": { "type": "number", "minimum": 0.6, "maximum": 3, "description": "Lay the text out line by line this many times the size apart (1.2 is tight, like an editor's text box). A background then becomes one exact card sized to the text (box card) or one box per line." },
        "padding": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 300 }, "description": "With lineHeight: space between the text and its card, in pixels at 1080; [all], [x, y] or [top, right, bottom, left]. Top and bottom are measured from the capitals' top and the last baseline. Default 0.32 x size." },
        "in": { "$ref": "#/$defs/animIn" },
        "out": { "$ref": "#/$defs/animOut" },
        "emphasis": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1 }, "description": "Words or phrases to colour differently (case-insensitive), like the red words in a headline card. Not with the typing animation." },
        "emphasisColor": { "$ref": "#/$defs/color", "description": "Colour of the emphasised words (default #E53935)." }
      }
    },
    "animIn": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": { "type": { "enum": ["fade", "pop", "up", "type"] }, "duration": { "type": "number", "minimum": 0.05, "maximum": 5, "description": "Default 0.4 (type: 1)." } }
    },
    "animOut": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": { "type": { "enum": ["fade", "down", "shrink"] }, "duration": { "type": "number", "minimum": 0.05, "maximum": 5, "default": 0.4 } }
    },

    "captions": {
      "type": "object", "required": ["words"], "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/look" }],
      "description": "Subtitles from a transcript. With src set, transcript times are seconds of that source file and WeCut moves each word onto the output timeline through every clip cut from it (speed included).",
      "properties": {
        "words": {
          "description": "Transcript file (.json word list, OpenAI/Groq verbose_json, whisper.cpp JSON, .srt, .vtt) or an inline array.",
          "oneOf": [
            { "$ref": "#/$defs/path" },
            {
              "type": "array",
              "items": {
                "type": "object", "required": ["start", "end"],
                "properties": { "word": { "type": "string" }, "text": { "type": "string" }, "start": { "type": "number" }, "end": { "type": "number" } }
              }
            }
          ]
        },
        "src": { "$ref": "#/$defs/path", "description": "The source video the transcript belongs to." },
        "accent": { "$ref": "#/$defs/accent" },
        "mode": { "enum": ["chunk", "karaoke", "pop", "reveal"], "description": "reveal = a phrase whose words light up one after another and stay lit; chunk = a phrase at a time; karaoke = phrase with the spoken word highlighted; pop = one word at a time." },
        "highlight": { "$ref": "#/$defs/colorOrNone", "description": "Karaoke: colour of the spoken word." },
        "maxWords": { "type": "integer", "minimum": 1, "maximum": 12 },
        "maxDuration": { "type": "number", "minimum": 0.5, "maximum": 10, "default": 2.6 },
        "x": { "$ref": "#/$defs/fraction" },
        "y": { "$ref": "#/$defs/fraction" }
      }
    },

    "overlay": {
      "type": "object", "required": ["src"], "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/$defs/path", "description": "png (with transparency), jpg or webp." },
        "start": { "$ref": "#/$defs/seconds" },
        "end": { "type": "number" },
        "x": { "$ref": "#/$defs/fraction", "default": 0.5, "description": "Centre of the image." },
        "y": { "$ref": "#/$defs/fraction", "default": 0.5 },
        "width": { "type": "number", "minimum": 0.02, "maximum": 1, "default": 0.3, "description": "Fraction of the canvas width." },
        "opacity": { "$ref": "#/$defs/percent" },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360 },
        "fadeIn": { "type": "number", "minimum": 0, "maximum": 10 },
        "fadeOut": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },

    "track": {
      "type": "object", "required": ["src"], "additionalProperties": false,
      "description": "Music, voice-over or sound effect mixed over the clips' own sound.",
      "properties": {
        "src": { "$ref": "#/$defs/path", "description": "mp3, m4a, aac, wav, ogg, opus, flac, or a video file's sound." },
        "at": { "$ref": "#/$defs/seconds", "description": "Output time where it starts." },
        "from": { "$ref": "#/$defs/seconds", "description": "Seconds into the audio file." },
        "to": { "type": "number" },
        "duration": { "type": "number", "minimum": 0, "description": "Longest it may play." },
        "volume": { "type": "number", "minimum": 0, "maximum": 200, "default": 100 },
        "fadeIn": { "type": "number", "minimum": 0, "maximum": 30 },
        "fadeOut": { "type": "number", "minimum": 0, "maximum": 30 },
        "loop": { "type": "boolean", "description": "Repeat until the video ends." },
        "duck": { "type": "boolean", "description": "Lower this track automatically whenever the clips have sound (speech)." }
      }
    },

    "filter": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "name": { "enum": ["color", "warm", "cool", "dusk", "gold", "mint", "leaf", "rose", "lavender", "coffee", "pale", "fog", "dark", "retro", "teal", "candy", "neon", "ocean", "cream", "sunset", "forest"] },
        "color": { "type": "string", "description": "With name color: #RRGGBB, washed over the picture by amount." },
        "amount": { "$ref": "#/$defs/percent", "default": 100 },
        "start": { "$ref": "#/$defs/seconds" },
        "end": { "type": "number" }
      }
    },

    "effect": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "name": { "enum": ["flash", "dim", "cinema", "frame", "night", "sepia"] },
        "start": { "$ref": "#/$defs/seconds" },
        "end": { "type": "number", "description": "Default: start plus the effect's own length (flash 0.3 s, dim 2 s, others 3 s)." }
      }
    }
  }
}
