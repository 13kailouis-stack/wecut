{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeCut portable template bundle v1",
  "type": "object", "additionalProperties": false,
  "required": ["bundle", "recipe", "assets"],
  "properties": {
    "bundle": { "const": "wecut.bundle/1" },
    "recipe": { "$ref": "wecut.recipe.schema.json" },
    "assets": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "data"],
        "properties": {
          "name": { "type": "string", "pattern": "^music\\.(mp3|m4a|wav|aac|ogg|flac|mp4|webm|mov)$" },
          "data": { "type": "string", "contentEncoding": "base64", "minLength": 4, "maxLength": 44739244 }
        }
      }
    }
  },
  "$comment": "Runtime also enforces a 48 MiB envelope limit, 32 MiB decoded audio limit, and exact agreement between recipe.music.src and the included asset."
}
