{
  "recipe": "1",
  "name": "vlog-phrases",
  "about": "A street or store vlog: fade in from black to a headline card, then full-frame handheld footage cut every couple of seconds with short caps phrases.",
  "output": { "ratio": "9:16", "res": 1080, "fps": 30 },
  "maxDuration": 45,
  "sections": [
    {
      "role": "hook",
      "duration": 5,
      "fit": "cover",
      "fadeIn": 0.8,
      "texts": [
        { "slot": "label", "style": "label", "y": 0.62 },
        { "slot": "headline", "style": "headline", "y": 0.71, "in": { "type": "pop", "duration": 0.35 } }
      ]
    },
    { "role": "body", "fit": "cover", "shot": 2 }
  ],
  "captions": { "style": "phrase", "maxWords": 4, "y": 0.6 },
  "effects": [ { "name": "flash", "on": "time", "at": -5 } ]
}
