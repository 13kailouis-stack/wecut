# graph
[0:v]setpts=PTS-STARTPTS,split=2[cb1][cf2];
[cb1]scale=270:480:force_original_aspect_ratio=increase,crop=270:480,boxblur=4:2,scale=1080:1920[cbg3];
[cf2]scale=1080:1920:force_original_aspect_ratio=decrease:flags=bicubic[cfg4];
[cbg3][cfg4]overlay=(W-w)/2:(H-h)/2,fps=30,format=yuv420p,setsar=1,tpad=stop_mode=clone:stop_duration=1,trim=duration=4,setpts=PTS-STARTPTS[v0];
[0:a]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,apad=whole_dur=4,atrim=duration=4[a0];
[1:v]setpts=(PTS-STARTPTS)/1.5,scale=1080:1920:force_original_aspect_ratio=increase:flags=bicubic,crop=1080:1920:(iw-1080)*0.5:(ih-1920)*0.5,fps=30,format=yuv420p,setsar=1,tpad=stop_mode=clone:stop_duration=1,trim=duration=3.333,setpts=PTS-STARTPTS[v1];
anullsrc=r=48000:cl=stereo,atrim=duration=3.333,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo[a1];
[v0][v1]xfade=transition=fadewhite:duration=0.3:offset=3.7[vj5];
[a0][a1]acrossfade=d=0.3:c1=tri:c2=tri[aj6];
[2:v]format=rgba,scale=194:-2,colorchannelmixer=aa=0.9[ov0];
[vj5][ov0]overlay=x=918-w/2:y=153.6-h/2:enable='between(t,0,7.033)':eof_action=pass[vo7];
[vo7]ass=f=wecut.ass:fontsdir=fonts,format=yuv420p[vout];
[3:a]atrim=duration=7.033,asetpts=PTS-STARTPTS,volume=0.4,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo[t0];
[aj6]asplit=2[am8][sc9];
[t0][sc9]sidechaincompress=threshold=0.02:ratio=8:attack=20:release=350:makeup=1[td10];
[am8][td10]amix=inputs=2:duration=first:dropout_transition=0:normalize=0,alimiter=limit=0.97:level=0[aout]

